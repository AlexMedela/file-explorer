# File Explorer talks to phones and cameras itself (its own iPhone and MTP / PTP connector, see src/devfs.c):
# let the user at the seat open them over USB. Android phones and cameras often get this from libmtp / libgphoto2
# already; iPhones otherwise only from usbmuxd's group. (70-: before systemd's 73-seat-late applies uaccess.)
ACTION=="remove", GOTO="fe_phones_end"
SUBSYSTEM!="usb", GOTO="fe_phones_end"
ENV{DEVTYPE}!="usb_device", GOTO="fe_phones_end"
ATTR{idVendor}=="05ac", ATTR{idProduct}=="12[9a]?", TAG+="uaccess"
ENV{ID_USB_INTERFACES}=="*:060101:*", TAG+="uaccess"
ENV{ID_MTP_DEVICE}=="1", TAG+="uaccess"
ENV{ID_GPHOTO2}=="1", TAG+="uaccess"
LABEL="fe_phones_end"

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- "Retry as administrator": File Explorer runs itself through pkexec (with its admin-op option) to copy, move,
     delete, rename or create files it is not allowed to. install.sh fills in @BINDIR@. -->
<policyconfig>
  <vendor>File Explorer</vendor>
  <action id="dev.fileexplorer.admin">
    <description>Change files as the administrator</description>
    <message>Authentication is required to change files that belong to the system</message>
    <icon_name>dev.fileexplorer</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@BINDIR@/file-explorer</annotate>
  </action>
</policyconfig>
